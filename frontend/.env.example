# Copiar a .env en la raíz del frontend (junto a package.json):
#   copy .env.example .env        (PowerShell, en la carpeta frontend)
# VITE_API_URL es la base de la API, SIN /auth. authService.js le agrega
# /auth para el login y usa la misma base para el resto de llamadas.
# Backend real (Spring Boot): http://localhost:8106/api
# En el VPS, cambia por la URL pública con HTTPS, p. ej. https://tu-dominio/api
VITE_API_URL=http://localhost:8106/api
# Modo demo (sin backend): false por defecto = backend real.
# Pon true para entrar con las cuentas demo sin arrancar el backend.
VITE_DEMO_MODE=false
# Respaldo demo: si el backend no responde (error de red) y esto no es
# 'false', el frontend cae a los datos demo para que la demo no se caiga.
# Pon 'false' cuando quieras ver el error real de conexión.
VITE_DEMO_FALLBACK=false
