# Copiar a .env en la raíz del frontend (junto a package.json):
#   copy .env.example .env        (PowerShell, en la carpeta frontend)
# VITE_API_URL es la base de la API, SIN /auth. authService.js le agrega
# /auth para el login y usa la misma base para el resto de llamadas.
VITE_API_URL=http://localhost:8106/api
