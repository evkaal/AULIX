# Copiar a /opt/aulix/.env en el VPS (o a .env en local, SIN subirlo a GitHub)
# y rellenar los valores reales. Este archivo es solo un ejemplo.
PORT=8106
DB_URL=jdbc:mysql://localhost:3306/aulix_db?createDatabaseIfNotExist=true&serverTimezone=America/Mexico_City
DB_USER=root
DB_PASS=tu_password_de_mysql
# Generar con: openssl rand -base64 32   (en el VPS o en Linux)
# o en PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=pega_aqui_el_secreto_base64_generado
JWT_EXPIRATION=86400000
UPLOAD_DIR=/opt/aulix/uploads
