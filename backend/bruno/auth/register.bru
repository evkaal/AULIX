meta {
  name: 01 - Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Prueba Estudiante",
    "email": "prueba@colegio.edu",
    "password": "Prueba123*",
    "rol": "ESTUDIANTE",
    "grupo": "3° A"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.token) {
    bru.setVar("token", body.token);
  }
}

tests {
  test("Register devuelve 201 con token", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
