meta {
  name: 05 - Cambio de contraseña
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "Docente123*",
    "newPassword": "Docente456*"
  }
}

tests {
  test("Cambio de contraseña devuelve 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
