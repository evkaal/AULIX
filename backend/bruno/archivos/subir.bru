meta {
  name: 01 - Subir archivo (max 20 MB, PDF/DOCX/imagen)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/archivos
  body: form-data
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:form-data {
  archivo: [file: ./archivo-ejemplo.pdf]
}

tests {
  test("Subir archivo devuelve 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
